worker_processes auto;

events {
    worker_connections 1024;
}

http {
    server {
        listen 80;
        server_name _;

        location / {
            proxy_pass http://192.168.1.90:8080;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # k3s nodes all run Traefik's ServiceLB on port 80 (bundled with k3s),
    # so any node's IP works as an entrypoint - listing all three here gives
    # basic round-robin/failover instead of depending on a single node.
    upstream k3s_nodes {
        server 192.168.1.100:80;
        server 192.168.1.101:80;
        server 192.168.1.102:80;
    }

    # Registries (Gitea, GitLab registry, Harbor): image layers can be hundreds
    # of MB, so there is no body size limit and uploads are streamed to Traefik
    # instead of being buffered on the proxy first. Gitea is here because its
    # registry shares the host with git. Add new registry hosts here.
    server {
        listen 80;
        server_name registry.gitlab.internal gitea.internal harbor.internal;

        location / {
            proxy_pass http://k3s_nodes;

            # Host header must be preserved as-is (not $proxy_host) so Traefik
            # can match the Ingress rule by hostname.
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_buffer_size 16k;
            proxy_buffers 4 16k;
            client_max_body_size 0;
            proxy_request_buffering off;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }
    }

    # Everything else (GitLab, ArgoCD, OpenBao): 100MB body limit. GitLab's web UI
    # sends large headers/cookies, hence the bigger buffers. Pushes over 100MB to
    # GitLab would need gitlab.internal to move to the block above.
    server {
        listen 80;
        server_name gitlab.internal argocd.internal openbao.internal;

        location / {
            proxy_pass http://k3s_nodes;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_buffer_size 16k;
            proxy_buffers 4 16k;
            client_max_body_size 100m;
        }
    }
}
